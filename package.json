{
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "ultracite": "^7.7.0",
    "vitest": "^4.1.4"
  },
  "name": "ts-enverify",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "version": "1.3.2",
  "description": "Type-safe environment variable validation for Node.js. Zero dependencies.",
  "author": "aradhyacp",
  "repository": {
    "type": "git",
    "url": "https://github.com/aradhyacp/ts-enverify"
  },
  "homepage": "https://github.com/aradhyacp/ts-enverify#readme",
  "bugs": {
    "url": "https://github.com/aradhyacp/ts-enverify/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "env",
    "environment",
    "environment-variables",
    "express",
    "validation",
    "validator",
    "typescript",
    "type-safe",
    "dotenv",
    "schema",
    "runtime-validation",
    "node",
    "nodejs",
    "config",
    "configuration",
    "startup",
    "zero-dependencies"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "npx ultracite fix"
    ]
  }
}
